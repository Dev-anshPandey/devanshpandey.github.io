# Server only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Choose an OpenAI model enabled for your account (see PORTFOLIO.md).
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Required for durable rate limits on Vercel / in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a random string of at least 32 characters to hash rate-limit identities.
RATE_LIMIT_SALT=
# Optional canonical origin, e.g. https://devansh.example.com
SITE_URL=http://localhost:3000
