# Production model-rate limiting (6 requests/minute/client).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters.
RATE_LIMIT_SALT=
SITE_URL=http://localhost:3000
